# rclone-extractor — copy this file and fill in your values, or paste into a
# container PaaS deploy form (SnapDeploy detects this file and shows the
# variables during deployment). One variable per line.

# --- required ---
APP_PASSWORD=change-me                  # sign-in password (environment only; never stored)
SECRET_KEY=change-me-too                # passphrase for encrypting stored secrets (omit to disable encryption)

# --- database (leave DATABASE_URL empty to use local SQLite; set it to use Postgres) ---
DATABASE_URL=
# e.g. postgres://user:pass@host:5432/db?sslmode=require
# From SnapDeploy: attach a PostgreSQL add-on (injected automatically) or paste
# an external connection string (Neon, Supabase, RDS, Aiven, …).
# If the service is capped ("remaining connection slots are reserved for roles
# with the SUPERUSER attribute", errno 53300), use its connection pooler /
# raise max_connections; keep PG_POOL_MAX small.
PG_POOL_MAX=4                            # max connections this app opens (default 4)
DATA_DIR=/app/data                      # SQLite file + working rclone.conf (only used for SQLite)

# --- rclone ---
# Base64-encoded rclone.conf, used only if the Configuration page has none.
RCLONE_CONF=                            # generate with: base64 -w0 rclone.conf
# Full path to the rclone binary, in case your host does not put it on PATH
# or you need the build that matches your CPU (arm64 vs amd64).
RCLONE_BIN=rclone

# --- http ---
BIND=0.0.0.0                            # bind address
PORT=8080                               # listen port (SnapDeploy sets "PORT" itself)
COOKIE_SECURE=1                         # 1 = session cookie HTTPS-only (default); set 0 for plain-HTTP LAN/testing
